@model LaboratorioCRUDProductos.Models.ProductoModel


@{
    ViewBag.Title = "Eliminar producto";
}


<h2>Eliminar producto</h2>


<h3>¿Está seguro de eliminar este producto?</h3>


<hr />


<dl class="dl-horizontal">
    <dt>ID</dt>
    <dd>@Model.Id</dd>


    <dt>Nombre</dt>
    <dd>@Model.Nombre</dd>


    <dt>Descripción</dt>
    <dd>@Model.Descripcion</dd>


    <dt>Precio</dt>
    <dd>@Model.Precio</dd>


    <dt>Stock</dt>
    <dd>@Model.Stock</dd>
</dl>


@using (Html.BeginForm("Delete", "Producto",
    new { id = Model.Id }, FormMethod.Post))
{
    @Html.AntiForgeryToken()


    <input type="submit"
           value="Eliminar"
           class="btn btn-danger" />


    @Html.ActionLink("Cancelar", "Index",
            null, new { @class = "btn btn-default" })
}