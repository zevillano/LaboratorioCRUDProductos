

@model IEnumerable<LaboratorioCRUDProductos.Models.ProductoModel>


@{
    ViewBag.Title = "Gestión de Productos";
}


<h2>Gestión de Productos</h2>
<p>Administra el catálogo de productos de tu empresa.</p>


<hr />


<p>
    <a href="@Url.Action("Create", "Producto")"
       class="btn btn-primary btn-producto">
        <span class="glyphicon glyphicon-plus"></span>
        Nuevo producto
    </a>
</p>


<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>S/ @item.Precio.ToString("N2")</td>
                    <td>@item.Stock</td>
                    <td class="acciones">
                        <a href="@Url.Action("Details", "Producto", new { id = item.Id })"
                           class="btn btn-info btn-sm btn-producto">
                            <span class="glyphicon glyphicon-eye-open"></span>
                            Detalles
                        </a>


                        <a href="@Url.Action("Edit", "Producto", new { id = item.Id })"
                           class="btn btn-warning btn-sm btn-producto">
                            <span class="glyphicon glyphicon-pencil"></span>
                            Editar
                        </a>


                        <a href="@Url.Action("Delete", "Producto", new { id = item.Id })"
                           class="btn btn-danger btn-sm btn-producto">
                            <span class="glyphicon glyphicon-trash"></span>
                            Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>