@model LaboratorioCRUDProductos.Models.ProductoModel


@{
    ViewBag.Title = "Detalles del producto";
}


<h2>Detalles del producto</h2>


<hr />


<dl class="dl-horizontal">


    <dt>ID</dt>
    <dd>@Model.Id</dd>


    <dt>Nombre</dt>
    <dd>@Model.Nombre</dd>


    <dt>Descripción</dt>
    <dd>@Model.Descripcion</dd>


    <dt>Precio</dt>
    <dd>S/ @Model.Precio.ToString("N2")</dd>


    <dt>Stock</dt>
    <dd>@Model.Stock</dd>


</dl>


<hr />


<p>
    @Html.ActionLink("Editar", "Edit",
            new { id = Model.Id },
            new { @class = "btn btn-warning" })


    @Html.ActionLink("Volver a la lista", "Index",
            null,
            new { @class = "btn btn-primary" })
</p>